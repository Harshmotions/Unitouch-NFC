# .env.example — commit this file. Real values: ask Harsh; never commit them.
# Production values live in the Vercel project that serves www.unitouch.in.

# Supabase (project region: South Asia, Mumbai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (live keys). Named RZP_* on purpose: on Vercel, RAZORPAY_*-named
# vars didn't reach the production runtime (see lib/razorpay/client.ts).
# The browser gets the public key id from the create-order response, so no
# NEXT_PUBLIC_ key is needed.
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://unitouch.in
NEXT_PUBLIC_APP_ENV=production

# Email (Resend). unitouch.in must be verified as a sending domain in Resend.
# Without a key, emails are skipped (logged), never fatal.
RESEND_API_KEY=
# Optional; defaults to "Unitouch <orders@unitouch.in>"
EMAIL_FROM=
# Signing secret ("whsec_...") of the Resend webhook for email.bounced and
# email.complained -> /api/webhook/resend. Without it that route refuses
# everything (bounce alerts off; nothing else affected).
RESEND_WEBHOOK_SECRET=

# Vercel cron auth for /api/cron/draft-reminders (any long random string;
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Upstash Redis (rate limiting, draft-reminder counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin: no env needed. There's one shared admin account
# (BUSINESS.adminEmail in lib/business.ts) signing in with a password + an
# emailed code. Set the password with:
#   node --env-file=.env.local scripts/set-admin-password.mjs
